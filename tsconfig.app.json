{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",

    "types": [
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],

    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "Bundler"
  },
  "include": ["src"]
}